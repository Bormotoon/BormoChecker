# BormoChecker configuration (copy to .env and adjust as needed)

# Local LLM endpoint (llama.cpp OpenAI-compatible server)
FACTCHECK_LLM_BASE_URL=http://127.0.0.1:11440/v1
FACTCHECK_LLM_MODEL=gemma-4
FACTCHECK_LLM_API_KEY=

# Web service auth & rate limiting
# Set to 0 for local/open demo mode, 1 to require token/passport auth
FACTCHECK_REQUIRE_AUTH=0
FACTCHECK_INTERNAL_TOKEN=
PASSPORT_HMAC_SECRET=

# Direct APIs (keyless HTTPS)
FACTCHECK_ENABLE_WIKIPEDIA=1
FACTCHECK_ENABLE_PRAVO_GOV=0
FACTCHECK_ENABLE_FGOSREESTR=0
FACTCHECK_ENABLE_CYBERLENINKA=0
FACTCHECK_ENABLE_MOS_RU=0

# Optional local search / mirrors
# SEARXNG_URL=http://127.0.0.1:8080
# FACTCHECK_MIRRORS_DIR=/path/to/site_mirrors
# BORMOCHECKER_GPU_LOCKED=0
